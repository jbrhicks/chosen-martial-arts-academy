{
  "name": "Group",
  "type": "object",
  "properties": {
    "group_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "group_type": {
      "type": "string",
      "enum": [
        "Global",
        "Program-Specific",
        "Challenge",
        "Custom"
      ],
      "default": "Custom"
    },
    "linked_program_id": {
      "type": "string"
    },
    "linked_challenge_id": {
      "type": "string"
    },
    "auto_archive_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "is_private": {
      "type": "boolean",
      "default": false
    },
    "created_by_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "group_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_private": false
        },
        {
          "data.created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}