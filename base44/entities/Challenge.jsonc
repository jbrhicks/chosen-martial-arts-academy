{
  "name": "Challenge",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "target_audience_type": {
      "type": "string",
      "enum": [
        "all",
        "program",
        "rank",
        "age_group",
        "family"
      ],
      "default": "all"
    },
    "target_program_id": {
      "type": "string"
    },
    "target_program_name": {
      "type": "string"
    },
    "target_rank": {
      "type": "string"
    },
    "min_age": {
      "type": "number",
      "default": 0
    },
    "max_age": {
      "type": "number",
      "default": 100
    },
    "enrollment_type": {
      "type": "string",
      "enum": [
        "auto",
        "opt_in"
      ],
      "default": "opt_in"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "goal_type": {
      "type": "string",
      "enum": [
        "attendance",
        "task",
        "media_proof"
      ],
      "default": "attendance"
    },
    "target_goal_value": {
      "type": "number",
      "default": 10
    },
    "unit_label": {
      "type": "string",
      "default": "classes"
    },
    "has_leaderboard": {
      "type": "boolean",
      "default": true
    },
    "badge_name": {
      "type": "string"
    },
    "badge_graphic_url": {
      "type": "string"
    },
    "linked_group_id": {
      "type": "string"
    },
    "auto_archive_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "archived"
      ],
      "default": "draft"
    },
    "participant_count": {
      "type": "number",
      "default": 0
    },
    "completion_count": {
      "type": "number",
      "default": 0
    },
    "created_by_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "goal_type",
    "target_goal_value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}