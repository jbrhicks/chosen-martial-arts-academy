{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_type": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "all"
      ],
      "default": "user"
    },
    "recipient_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "dm",
        "post_comment",
        "new_event",
        "rank_up",
        "announcement",
        "new_lead",
        "enrollment",
        "account_request",
        "support",
        "new_post",
        "billing"
      ]
    },
    "preview_text": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "lead",
        "event",
        "thread",
        "curriculum",
        "post",
        "profile",
        "billing",
        "membership",
        "account_request",
        "message",
        "none"
      ]
    },
    "target_id": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_date": {
      "type": "string",
      "format": "date-time"
    },
    "aggregate_count": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "notification_type",
    "preview_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}